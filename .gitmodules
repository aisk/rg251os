[submodule "external/trusted-firmware-a"]
	path = external/trusted-firmware-a
	url = https://git.trustedfirmware.org/TF-A/trusted-firmware-a.git
	shallow = true
	branch = lts-v2.14
[submodule "external/u-boot"]
	path = external/u-boot
	url = https://github.com/u-boot/u-boot.git
	shallow = true
[submodule "external/rkbin"]
	path = external/rkbin
	url = https://github.com/rockchip-linux/rkbin.git
	shallow = true
[submodule "external/linux"]
	path = external/linux
	url = https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git
	shallow = true
	branch = linux-6.18.y
[submodule "external/u-boot-legacy"]
	path = external/u-boot-legacy
	url = https://github.com/ROCKNIX/hardkernel-uboot.git
	branch = RK3326
	shallow = true
[submodule "external/mgba"]
	path = external/mgba
	url = https://github.com/mgba-emu/mgba.git
	branch = 0.10
	shallow = true
[submodule "external/tinyalsa"]
	path = external/tinyalsa
	url = https://github.com/tinyalsa/tinyalsa.git
	shallow = true
[submodule "external/gpsp"]
	path = external/gpsp
	url = https://github.com/libretro/gpsp.git
	branch = master
	shallow = true
[submodule "external/pl_mpeg"]
	path = external/pl_mpeg
	url = https://github.com/phoboslab/pl_mpeg.git
	branch = master
	shallow = true

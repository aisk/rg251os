# Diagnostics, merged unless LINUX_DEBUG=0 (mk/linux.mk).

# Kernel log on the panel through fbcon (console=tty0 in extlinux.conf),
# since there is no serial cable yet
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y

# What the frontend's debug log (debug=on in settings.txt) reads: /proc/asound
# hw_params/sw_params/status, ALSA XRUN and hw_ptr jump reports in dmesg
# (it writes 1 to .../pcm0p/xrun_debug). Without them those log lines just
# report the files as missing.
CONFIG_SND_PROC_FS=y
CONFIG_SND_VERBOSE_PROCFS=y
CONFIG_SND_DEBUG=y
CONFIG_SND_PCM_XRUN_DEBUG=y

# debugfs, mounted by the frontend at /sys/kernel/debug: the RK817
# registers through regmap's debugfs files (regmap/<i2c dev>/registers)
# for the charger lines in battery.c. Without it they are left out.
CONFIG_DEBUG_FS=y

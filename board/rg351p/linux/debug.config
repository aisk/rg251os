# Debug-only options: kernel log on the panel through fbcon, since there
# is no serial cable yet. Drop by building with LINUX_DEBUG=0.
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
# Status LED shows boot progress, see the dts
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_PANIC=y

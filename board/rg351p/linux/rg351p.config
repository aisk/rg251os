# RG351P kernel config fragment, merged on top of allnoconfig.
# Everything is built in: no modules, no networking, no initramfs.

# General
CONFIG_LOCALVERSION=""
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="rg351p"
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_NR_CPUS=4
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BINFMT_ELF=y
# CONFIG_MODULES is not set
# CONFIG_NET is not set
# CONFIG_BLK_DEV_INITRD is not set
# KALLSYMS_ALL and DEBUG_INFO need DEBUG_KERNEL, which stays off

# SoC
CONFIG_ARCH_ROCKCHIP=y
CONFIG_ARM_PSCI_FW=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ARM_GIC=y
CONFIG_COMMON_CLK_ROCKCHIP=y
CONFIG_CLK_PX30=y
CONFIG_COMMON_CLK_RK808=y
CONFIG_PINCTRL_ROCKCHIP=y
CONFIG_GPIO_ROCKCHIP=y
CONFIG_RESET_CONTROLLER=y
CONFIG_ROCKCHIP_PM_DOMAINS=y
CONFIG_ROCKCHIP_IODOMAIN=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_ROCKCHIP_IOMMU=y
CONFIG_DMADEVICES=y
CONFIG_PL330_DMA=y

# Power management. SUSPEND gives "mem" in /sys/power/state through PSCI
# SYSTEM_SUSPEND (rkbin BL31), used by the frontend's power key sleep.
# PM_DEBUG adds pm_wakeup_irq, pm_debug_messages and pm_print_times in
# /sys/power, logged and switched on by the frontend around each sleep.
CONFIG_PM=y
CONFIG_SUSPEND=y
CONFIG_PM_DEBUG=y
CONFIG_CPU_IDLE=y
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
# time_in_state and total_trans, logged per game by the frontend
CONFIG_CPU_FREQ_STAT=y
# The frontend sets a frequency floor in game as uclamp_min on its thread
CONFIG_UCLAMP_TASK=y
CONFIG_CPUFREQ_DT=y
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_CPU_THERMAL=y
CONFIG_ROCKCHIP_THERMAL=y

# UART2 (ttyS2, 115200). Not the console unless extlinux.conf says so.
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y

# Storage: sdmmc only
CONFIG_BLOCK=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y

# Filesystems
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_IOCHARSET="iso8859-1"
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
# The frontend watches /dev/input with inotify for the USB gamepad
CONFIG_INOTIFY_USER=y

# PMIC (RK817 on i2c0)
CONFIG_I2C=y
CONFIG_I2C_RK3X=y
CONFIG_MFD_RK8XX_I2C=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_RK808=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_RK808=y
# Wall clock from the RK817 RTC (if it was ever set) for perf.csv
CONFIG_RTC_HCTOSYS=y
CONFIG_POWER_SUPPLY=y
CONFIG_CHARGER_RK817=y

# Input: power key, vibration motor, internal USB gamepad
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_FF_MEMLESS=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_RK805_PWRKEY=y
CONFIG_INPUT_PWM_VIBRA=y

# USB host (gamepad)
CONFIG_EXTCON=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_HOST=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# Display: VOP + DW MIPI DSI + KD35T133 panel, PWM backlight
CONFIG_PWM=y
CONFIG_PWM_ROCKCHIP=y
CONFIG_DRM=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP=y
CONFIG_ROCKCHIP_DW_MIPI_DSI=y
CONFIG_PHY_ROCKCHIP_INNO_DSIDPHY=y
CONFIG_DRM_PANEL_ELIDA_KD35T133=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
# No GPU driver: CPU renders into KMS dumb buffers, GPU domain stays off
# CONFIG_DRM_PANFROST is not set

# Status LED. The heartbeat trigger shows the kernel is up until the
# frontend takes the LED over (it clears the trigger), the panic trigger
# blinks it on a kernel panic, see the dts.
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_PANIC=y

# Sound: RK817 codec on i2s1 via simple-audio-card
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_TIMER=y
CONFIG_SND_PCM=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_ROCKCHIP_I2S=y
CONFIG_SND_SOC_RK817=y
CONFIG_SND_SIMPLE_CARD=y

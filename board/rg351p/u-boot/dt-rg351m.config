# UBOOT_DT=rg351m (default)
# Device tree: mainline RG351M DT plus rk3326-rg351p-u-boot.dtsi. A single
# DT in the FIT means SPL always picks it (go2.c's SARADC match fails for
# every entry and the default config is used). go2.c still sets fdtfile to
# the OGA v11 dtb because the RG351P ADC value (655-695) falls in the OGA
# Black Edition window; nothing uses fdtfile, extlinux.conf names the dtb.
CONFIG_DEFAULT_DEVICE_TREE="rockchip/rk3326-anbernic-rg351m"
CONFIG_OF_LIST="rockchip/rk3326-anbernic-rg351m"
CONFIG_SPL_OF_LIST="rockchip/rk3326-anbernic-rg351m"

# RG351P config fragment, merged on top of configs/odroid-go2_defconfig.
# The board code stays TARGET_ODROID_GO2 (go2.c); only the DT, boot flow and
# feature set change. The extra DT include option is added by
# mk/bootloader.mk because it needs an absolute path.

# The dtb handed to Linux is named in extlinux.conf; fdtfile is unused.
CONFIG_DEFAULT_FDT_FILE="rk3326-anbernic-rg351p.dtb"

# Boot flow: no bootflow scan, go straight to extlinux.conf on the FAT
# partition 1 of the SD card. The SD slot (sdmmc) is mmc 0 via the DT
# alias, and it is the only MMC device enabled. BOOTDELAY=0 still checks
# once for a key on the serial console, so boot can be interrupted for free.
CONFIG_BOOTDELAY=0
CONFIG_USE_BOOTCOMMAND=y
# Bring-up aid, so U-Boot reaching bootcmd is visible without a serial
# console: pulse the vibration motor (GPIO0_B7, "A15"), then blink the status
# LED (GPIO2_B5, "C13") red three times and leave it red. Drop once a UART is
# wired up.
CONFIG_BOOTCOMMAND="gpio set A15; sleep 0.3; gpio clear A15; for i in 1 2 3; do gpio set C13; sleep 0.2; gpio clear C13; sleep 0.2; done; gpio set C13; sysboot mmc 0:1 fat ${pxefile_addr_r} /extlinux/extlinux.conf"
CONFIG_CMD_SYSBOOT=y
# CONFIG_BOOTSTD is not set
# CONFIG_CMD_BOOTFLOW is not set
# CONFIG_CMD_PXE is not set

# Environment: built-in default only, never read or written on the SD card
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_ENV_IS_IN_MMC is not set
# CONFIG_ENV_IS_IN_SPI_FLASH is not set
# CONFIG_CMD_SAVEENV is not set

# No EFI
# CONFIG_EFI_LOADER is not set
# CONFIG_CMD_BOOTEFI is not set
# CONFIG_CMD_EFICONFIG is not set

# No network
# CONFIG_NET is not set

# No USB at all. Besides speed, this keeps U-Boot away from the USB host 5V
# path; on the RG351P/M the OGA vcc_host enable pin (GPIO0_B7) is the
# vibration motor PWM, and the RG351M DT has no vcc_host node at all.
# CONFIG_USB is not set
# CONFIG_USB_GADGET is not set
# CONFIG_CMD_USB is not set
# CONFIG_CMD_ROCKUSB is not set
# CONFIG_CMD_USB_MASS_STORAGE is not set
# CONFIG_FASTBOOT is not set
# CONFIG_CMD_FASTBOOT is not set

# No SPI flash (none fitted), boot from SD only, no SPI image
# CONFIG_ROCKCHIP_SPI_IMAGE is not set
# CONFIG_ROCKCHIP_SFC is not set
# CONFIG_SPL_SPI_LOAD is not set
# CONFIG_SPL_SPI_FLASH_SUPPORT is not set
# CONFIG_SPL_SPI is not set
# CONFIG_SPI_FLASH is not set
# CONFIG_CMD_SF is not set
# CONFIG_SPI is not set

# Peripherals U-Boot has no use for here
# CONFIG_SOUND is not set
# CONFIG_LED is not set
# CONFIG_CMD_LED is not set
# CONFIG_BUTTON is not set
# CONFIG_CMD_BUTTON is not set

# SPL loads the FIT without hash/signature checks (saves hashing ~1MB in
# software on every boot). U-Boot proper does not need FIT signatures either.
# CONFIG_SPL_FIT_SIGNATURE is not set
# CONFIG_FIT_SIGNATURE is not set

# Host tools: mkeficapsule is the only tool needing gnutls and libuuid
# CONFIG_TOOLS_MKEFICAPSULE is not set
